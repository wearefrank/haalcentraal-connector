<!DOCTYPE Configuration [
    <!ENTITY BrpPersonenUpdateAndNotify SYSTEM "Configuration_BrpPersonenUpdateAndNotify.xml">
    <!ENTITY BrpPersonenSynchronizePersoon SYSTEM "Configuration_BrpPersonenSynchronizePersoon.xml">
    <!ENTITY BrpPersonenQuerySender SYSTEM "Configuration_BrpPersonenQuerySender.xml">
    <!ENTITY XmlFileAdapter SYSTEM "Configuration_XmlFileAdapter.xml">
    <!ENTITY BrpPersonenNotificationProcessor SYSTEM "Configuration_BrpPersonenNotificationProcessor.xml">
    <!ENTITY BrpPersonenNotificationReceiver SYSTEM "Configuration_BrpPersonenNotificationReceiver.xml">
    <!ENTITY BrpPersonenCallbackSender SYSTEM "Configuration_BrpPersonenCallbackSender.xml">
    <!ENTITY BrpPersonenAfnemersIndicatieReceiver SYSTEM "Configuration_BrpPersonenAfnemersIndicatieReceiver.xml">
    <!ENTITY QueueNotificationTask SYSTEM "Configuration_QueueNotificationTask.xml">
    <!ENTITY CreateBulkImportTasks SYSTEM "Configuration_CreateBulkImportTasks.xml">
    <!ENTITY ProcessBulkImportTask SYSTEM "Configuration_ProcessBulkImportTask.xml">
    <!ENTITY ProcessBulkImportTasksBAG SYSTEM "Configuration_ProcessBulkImportBAG.xml">
    <!ENTITY GetPersoon SYSTEM "Configuration_BrpGetPersoon.xml">
    <!ENTITY GetPersoonssleutel SYSTEM "Configuration_GetPersoonssleutel.xml">
]>

<Configuration name="subscription-management-and-processing">
    &BrpPersonenUpdateAndNotify;
	&BrpPersonenSynchronizePersoon;
	&BrpPersonenQuerySender;
	&XmlFileAdapter;
	&BrpPersonenNotificationProcessor;
	&BrpPersonenNotificationReceiver;
	&BrpPersonenCallbackSender;
    &GetPersoonssleutel;
	&BrpPersonenAfnemersIndicatieReceiver;
    &QueueNotificationTask;
	&CreateBulkImportTasks;
	&ProcessBulkImportTask;
	&ProcessBulkImportTasksBAG;
    &GetPersoon;
    
    <!-- One HttpSession per authType, selected via 'outway-${hcc.outway.callback.authType}-connector'.
         Only the session matching hcc.outway.callback.authType is active, see DeploymentSpecifics.properties.
         A session per authType is needed because FF errors on attributes that are empty or have default values. -->
    <SharedResources>
        <HttpSession
            name="outway-none-connector"
            active="${hcc.outway.callback.none.active}"

            proxyHost="${hcc.outway.proxy.host}"
            proxyPort="${hcc.outway.proxy.port}"
            proxyAuthAlias="${hcc.outway.proxy.authAlias}"
            />
        <HttpSession
            name="outway-mtls-connector"
            active="${hcc.outway.callback.mtls.active}"

            keystore="${hcc.outway.keystore.uri}"
            keystoreType="${hcc.outway.keystore.type}"
            keystoreAuthAlias="${hcc.outway.keystore.authAlias}"
            keystoreAlias="${hcc.outway.keystore.alias}"
            keystoreAliasAuthAlias="${hcc.outway.keystore.aliasAuthAlias}"
            keystorePassword="${hcc.outway.keystore.password}"
            
            proxyHost="${hcc.outway.proxy.host}"
            proxyPort="${hcc.outway.proxy.port}"
            proxyAuthAlias="${hcc.outway.proxy.authAlias}"
            />
        <HttpSession
            name="outway-oauth2-connector"
            active="${hcc.outway.callback.oauth2.active}"

            clientAlias="${hcc.outway.clientAlias}"
            clientId="${hcc.outway.clientId}"
            clientSecret="${hcc.outway.clientSecret}"
            tokenEndpoint="${hcc.outway.tokenEndpoint}"
            oauthAuthenticationMethod="${hcc.outway.oauthAuthenticationMethod}"
            scope="${hcc.outway.scope}"

            proxyHost="${hcc.outway.proxy.host}"
            proxyPort="${hcc.outway.proxy.port}"
            proxyAuthAlias="${hcc.outway.proxy.authAlias}"
            />
        <HttpSession
            name="outway-oauth2mtls-connector"
            active="${hcc.outway.callback.oauth2mtls.active}"

            clientAlias="${hcc.outway.clientAlias}"
            clientId="${hcc.outway.clientId}"
            clientSecret="${hcc.outway.clientSecret}"
            tokenEndpoint="${hcc.outway.tokenEndpoint}"
            oauthAuthenticationMethod="${hcc.outway.oauthAuthenticationMethod}"
            scope="${hcc.outway.scope}"
            
            proxyHost="${hcc.outway.proxy.host}"
            proxyPort="${hcc.outway.proxy.port}"
            proxyAuthAlias="${hcc.outway.proxy.authAlias}"
            
            keystore="${hcc.outway.keystore.uri}"
            keystoreType="${hcc.outway.keystore.type}"
            keystoreAuthAlias="${hcc.outway.keystore.authAlias}"
            keystoreAlias="${hcc.outway.keystore.alias}"
            keystoreAliasAuthAlias="${hcc.outway.keystore.aliasAuthAlias}"
            keystorePassword="${hcc.outway.keystore.password}"
            />
    </SharedResources>
</Configuration>